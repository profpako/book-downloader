{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Downloader",
  "version": "0.1.0",
  "identifier": "it.bookdownloader.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix app",
    "beforeBuildCommand": "npm run build --prefix app",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "security": {"csp": null},
    "windows": [{"label": "main", "title": "Book Downloader", "width": 1180, "height": 760, "minWidth": 760, "minHeight": 600}]
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "targets": ["nsis", "dmg"],
    "windows": {"nsis": {"installMode": "currentUser"}},
    "macOS": {"signingIdentity": "-"},
    "externalBin": ["binaries/api"]
  },
  "plugins": {"shell": {"open": false, "scope": [{"name": "binaries/api", "sidecar": true, "args": true}]}}
}
